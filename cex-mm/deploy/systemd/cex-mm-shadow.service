[Unit]
Description=cex-mm shadow test (dry-run quotes + Delta mainnet trade recorder, no orders)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/iprime2/projects/crypto-strategy/cex-mm
Environment=PATH=/home/iprime2/.cargo/bin:/home/iprime2/.local/bin-wrappers:/usr/local/bin:/usr/bin:/bin
Environment=SHADOW_SYMBOLS=ADAUSDT,KITEUSDT,BERAUSDT,MUBARAKUSDT,DUSKUSDT,REDUSDT
# At boot the WSL network can come up after the user manager; wait for DNS before building and connecting.
ExecStartPre=/bin/sh -c 'until getent hosts api.india.delta.exchange >/dev/null; do sleep 2; done'
ExecStart=/home/iprime2/projects/crypto-strategy/cex-mm/scripts/shadow.sh start ${SHADOW_SYMBOLS}
ExecStop=/home/iprime2/projects/crypto-strategy/cex-mm/scripts/shadow.sh stop
TimeoutStartSec=600

[Install]
WantedBy=default.target
