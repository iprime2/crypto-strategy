# Delta Inside-Spread Maker (DISM) profile. No secrets here: keys stay in the gitignored .env files.
#
# One source for the quote settings: scripts/shadow.sh runs the shadow test with exactly these
# lines, and a live run must use the same file. Evidence for each value:
# artifacts/research/2026-10-05-dism-gate-six-coins.md.

MM_VENUE=delta

# Fair value. The 6-12 Oct gate was measured with MM_FAIR_ANCHOR_WEIGHT=0 (Delta book + 3 s Binance move).
# The first real-money run (13 Oct) was picked off because that fair trails Binance by ~3 bps (p90 ~7.5);
# the anchor quotes around Binance x (1 + Delta-Binance basis, 120 s average) instead. Shadow test first:
# artifacts/research/2026-10-13-live-run-pickoff.md. Live, an anchored symbol needs MM_FAIR_ANCHOR_LIVE=depth on
# the depth source (the bot and scripts/live.sh refuse otherwise). The gate in plans/live-basis.plan.md passed
# for ADA (G1-G4 on 18 Oct 2026, G6 on 19 Oct), so ADA's live flag is set below (owner's approval, 20 Oct).
MM_FAIR_ANCHOR_WEIGHT=1
# The basis reads the ob_l2 depth mid, which our own quotes cannot move (plans/live-basis.plan.md). Only ADA
# is anchored. DUSK and KITE: their anchor did not help in the 13 Oct memo, and their books are thin. BERA:
# on the 15-18 Oct shadow its depth basis failed the gate replay (p90 8.2 bps off the clean L1 basis, pivot
# share 5.8%, self-reference p99 2.2 bps; artifacts/research/2026-10-18-shadow-3day-review.md).
MM_BASIS_SOURCE=depth
MM_FAIR_ANCHOR_WEIGHT_BERAUSDT=0
MM_FAIR_ANCHOR_WEIGHT_DUSKUSDT=0
MM_FAIR_ANCHOR_WEIGHT_KITEUSDT=0
MM_FAIR_ANCHOR_LIVE_ADAUSDT=depth
MM_BASIS_HALFLIFE_SEC=120
MM_OFI_BETA=0.01
MM_WARMUP_SAMPLES=32
MM_MAKER_FEE_BPS=2.12
MM_ADVERSE_BUFFER_BPS=0
# AS bounds only matter if fixed mode is turned off.
MM_HALF_SPREAD_BPS=4
MM_MIN_HALF_SPREAD_BPS=4
MM_MAX_HALF_SPREAD_BPS=6
# L1 size imbalance is not a crash signal on Delta alts.
MM_REGIME_L3_DEPTH_RATIO=0
# fstream.binance.com does not resolve on the home network; the spot mirror leads Delta by <0.5 s.
MM_BINANCE_WS_BASE=wss://data-stream.binance.vision/ws
MM_DELTA_BOOK_FEED=ws
MM_BOOK_STALE_MS=2000
# The depth source's threshold in base units (MM_BASIS_SOURCE=depth; plans/live-basis.plan.md). Chosen on the 14 Oct ob_l2 probe:
# reached on every snapshot within 8 levels, and others' inside size never in [X - Q, X) for Q up to 200
# contracts (KITE: up to 50).
MM_BASIS_DEPTH_QTY_ADAUSDT=10000
MM_BASIS_DEPTH_QTY_BERAUSDT=10000
MM_BASIS_DEPTH_QTY_DUSKUSDT=300000
MM_BASIS_DEPTH_QTY_KITEUSDT=100000

# Quote rule: fair +/- 6 bps (x regime multiplier). Was 5 until 30 Oct 2026: on the simulator leg that reproduced the
# live run (1000 ms, touch, Scalper Offer) 6 beat 5 at every cap on 27-30 Oct (2026-10-30-ada-stop-postmortem.md);
# the owner chose 6 / 400 for the 30 Oct restart while the pinned forward test runs.
MM_FIXED_HALF_SPREAD_BPS=6
MM_REQUOTE_TOL_BPS=3
# Two-sided until the hard inventory cap, constant size (the simulator's assumptions).
MM_INV_ONE_SIDED_RATIO=0
MM_SIZE_SHAPE_FACTOR=0

# Size: ADA only (the only symbol that passed). The owner's size ladder (20 Oct 2026, $292 account): stage 1
# was 100 / 300 (~$22 a quote, ~$65 cap) for the first 300 live fills; stage 2, after those fills made at least
# +1 bp per $ traded with no abort, is the plan's maximum: ~$45 a quote and a ~$135 cap at $0.225. A third stage
# grows through capital or a second market, not a bigger quote on this account.
# The shadow test passes --symbols, which overrides MM_SYMBOLS.
MM_SYMBOLS=ADAUSDT
MM_ORDER_QTY_ADAUSDT=200
# Cap of 2 quotes since 30 Oct 2026 (was 600): the losses of 29-30 Oct came with the position at the cap.
MM_MAX_INVENTORY_ADAUSDT=400

# Real-money guards (live runs only; the shadow dry-run has no keys). Daily stop $10 (~3% of the $331 account) since
# 30 Oct 2026 (was $15), the owner's choice.
MM_DAILY_LOSS_LIMIT_USD=10
MM_ACCOUNT_POLL_SEC=30
MM_DMS_TTL_MS=15000
MM_MAX_LEVERAGE=5
