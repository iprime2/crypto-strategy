# Delta Inside-Spread Maker (DISM) profile. No secrets here: keys stay in the gitignored .env files.
#
# One source for the quote settings: scripts/shadow.sh runs the shadow test with exactly these
# lines, and a live run must use the same file. Evidence for each value:
# artifacts/research/2026-10-05-dism-gate-six-coins.md.

MM_VENUE=delta

# Fair value: unchanged from the shadow runs the gate was measured on.
MM_OFI_BETA=0.01
MM_WARMUP_SAMPLES=32
MM_MAKER_FEE_BPS=2.12
MM_ADVERSE_BUFFER_BPS=0
# AS bounds only matter if fixed mode is turned off.
MM_HALF_SPREAD_BPS=4
MM_MIN_HALF_SPREAD_BPS=4
MM_MAX_HALF_SPREAD_BPS=6
# L1 size imbalance is not a crash signal on Delta alts.
MM_REGIME_L3_DEPTH_RATIO=0
# fstream.binance.com does not resolve on the home network; the spot mirror leads Delta by <0.5 s.
MM_BINANCE_WS_BASE=wss://data-stream.binance.vision/ws
MM_DELTA_BOOK_FEED=ws
MM_BOOK_STALE_MS=2000

# Quote rule: fair +/- 5 bps (x regime multiplier), the shadow test's best ADA setting.
MM_FIXED_HALF_SPREAD_BPS=5
MM_REQUOTE_TOL_BPS=3
# Two-sided until the hard inventory cap, constant size (the simulator's assumptions).
MM_INV_ONE_SIDED_RATIO=0
MM_SIZE_SHAPE_FACTOR=0

# Size: ADA only (the only symbol that passed). ~$50 a quote, ~$150 inventory cap at $0.25.
# The shadow test passes --symbols, which overrides MM_SYMBOLS.
MM_SYMBOLS=ADAUSDT
MM_ORDER_QTY_ADAUSDT=200
MM_MAX_INVENTORY_ADAUSDT=600

# Real-money guards (live runs only; the shadow dry-run has no keys). Daily stop ~10% of the $150 cap.
MM_DAILY_LOSS_LIMIT_USD=15
MM_ACCOUNT_POLL_SEC=30
MM_DMS_TTL_MS=15000
MM_MAX_LEVERAGE=5
