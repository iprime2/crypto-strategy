# Bybit testnet/mainnet (Read + Trade only; no withdraw)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Delta Exchange India — demo keys from https://testnet.delta.exchange/ (env=testnet)
# Production India: https://india.delta.exchange/ + MM_VENUE=delta --env mainnet
DELTA_API_KEY=
DELTA_API_SECRET=
# MM_VENUE=bybit   # or delta

# One symbol (legacy) or comma-separated list for multi-symbol in one process:
# MM_SYMBOL=BTCUSDT
# MM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Top N liquid USDT linear perps by 24h turnover (Bybit, at startup; no API key needed):
MM_TOP_N=10
# Pin symbols first, then fill to N by liquidity: MM_SYMBOLS=BTCUSDT MM_TOP_N=10
# MM_TOP_N_EXCLUDE=1000PEPEUSDT,1000BONKUSDT

MM_ORDER_QTY=0.001
MM_MAX_INVENTORY=0.01
# Per-symbol overrides (optional):
# MM_ORDER_QTY_ETHUSDT=0.01
# MM_MAX_INVENTORY_ETHUSDT=0.05
MM_DAILY_LOSS_LIMIT_USD=150
MM_REJECT_KILL_COUNT=500
MM_CANCEL_ALL_ON_START=1
MM_USE_VENUE_INVENTORY=1
MM_VENUE_RECONCILE_SEC=5
MM_REQUOTE_TOL_BPS=3
MM_OFI_BETA=0.01
MM_WARMUP_SAMPLES=32
MM_MARKOUT_THRESHOLD_BPS=3
MM_MARKOUT_WIDEN_BPS=4
MM_MARKOUT_SIDE_AWARE=1

# Regime L3 (cancel-all): lower depth threshold on demo/testnet if book is often one-sided
# Demo: MM_REGIME_L3_DEPTH_RATIO=0 disables depth L3; mainnet ~0.15–0.2
# MM_REGIME_L3_JUMP_BPS=50
# MM_REGIME_L3_FLOW_Z=4
# MM_QUEUE_MAX_FRONT_FRAC=0.9

RUST_LOG=info,mm_bot=info,MM_METRICS=info,MM_ORDER=info
