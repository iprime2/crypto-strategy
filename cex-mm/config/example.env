# Bybit testnet/mainnet (Read + Trade only; no withdraw)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Delta Exchange India — demo keys from https://testnet.delta.exchange/ (env=testnet)
# Production India: https://india.delta.exchange/ + MM_VENUE=delta --env mainnet
# (The older names DELTA_API_KEY / DELTA_API_SECRET still work when these are unset.)
DELTA_DEMO_API_KEY=
DELTA_DEMO_API_SECRET=
# Production keys are separate and only read with --env mainnet (demo keys never trade real money).
# Read + Trade only; restrict them to the server's IP in Delta's API settings.
# DELTA_MAINNET_API_KEY=
# DELTA_MAINNET_API_SECRET=
# MM_VENUE=bybit   # or delta

# One symbol (legacy) or comma-separated list for multi-symbol in one process:
# MM_SYMBOL=BTCUSDT
# MM_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Top N liquid USDT linear perps by 24h turnover (Bybit, at startup; no API key needed):
MM_TOP_N=10
# Pin symbols first, then fill to N by liquidity: MM_SYMBOLS=BTCUSDT MM_TOP_N=10
# MM_TOP_N_EXCLUDE=1000PEPEUSDT,1000BONKUSDT

MM_ORDER_QTY=0.001
MM_MAX_INVENTORY=0.01
# Per-symbol overrides (optional):
# MM_ORDER_QTY_ETHUSDT=0.01
# MM_MAX_INVENTORY_ETHUSDT=0.05
MM_DAILY_LOSS_LIMIT_USD=150
# Live runs: daily loss stop on venue equity (persisted per IST day, from 18:30 UTC, in artifacts/risk/), taker-fill guard,
# both polled every MM_ACCOUNT_POLL_SEC. MM_DMS_TTL_MS > 0 arms Delta's dead man's switch: Delta cancels
# our orders if no heartbeat arrives within the TTL (process or network down). 0 = off.
MM_ACCOUNT_POLL_SEC=30
# MM_DMS_TTL_MS=15000
# Mainnet start is refused if Delta's order leverage on any quoted product is above this (default 5;
# Delta defaults to 100x and the bot never sets it). Demo only warns. Non-positive falls back to 5.
# MM_MAX_LEVERAGE=5
MM_REJECT_KILL_COUNT=500
MM_CANCEL_ALL_ON_START=1
MM_USE_VENUE_INVENTORY=1
MM_VENUE_RECONCILE_SEC=5
# A venue position read within this long of our last fill is not adopted (Delta's REST position trails the
# fills feed); a difference that lasts MM_RECONCILE_MAX_WAIT_SEC is adopted anyway.
MM_RECONCILE_FILL_GRACE_MS=3000
MM_RECONCILE_MAX_WAIT_SEC=15
MM_REQUOTE_TOL_BPS=3
MM_OFI_BETA=0.01
# Fair lead on the recent Binance mid move: shift = clamp(BETA * move_bps(LOOKBACK), ±MAX_BPS); MAX_BPS<=0 disables clamp
MM_LEAD_LOOKBACK_SEC=3
MM_LEAD_BETA=0.8
MM_LEAD_MAX_BPS=15
# Fair anchored to the Binance level: fair = (1-W) x Delta book fair + W x Binance mid x (1 + basis), with the
# move lead scaled by (1-W). basis = Delta-over-Binance mid, exponential average (HALFLIFE). The anchor is used
# only while the Binance feed sent a message within STALE_MS and the basis is WARMUP old and updated within
# MAX_AGE (older: it warms up again). Live, the basis is not updated while our own quote is the Delta touch.
# Each basis sample is clamped to the average +/- CLAMP_BPS. W=0 is the old fair. A live run (`run`) refuses
# W>0 unless MM_FAIR_ANCHOR_LIVE=depth with MM_BASIS_SOURCE=depth (the only source our own quotes cannot
# move); scripts/live.sh refuses any anchor weight or live flag until the live basis gate passes.
MM_FAIR_ANCHOR_WEIGHT=0
# Where the basis average reads Delta's price: book (the L1 mid, skipped while our quote is the touch) or depth
# (the ob_l2 depth mid; MM_BASIS_MAX_AGE_SEC then defaults to 30). Per symbol: MM_BASIS_SOURCE_ADAUSDT.
# MM_BASIS_SOURCE=book
# Live, with an anchor weight above 0: the anchor off for longer than this pulls both quotes until it is back,
# and the first quotes wait for it.
# MM_FAIR_ANCHOR_OFF_PULL_SEC=10
MM_BASIS_HALFLIFE_SEC=120
MM_BASIS_WARMUP_SEC=60
# Basis average older than this restarts its warm-up; default 300 for the book source, 30 for depth.
# MM_BASIS_MAX_AGE_SEC=300
MM_BASIS_CLAMP_BPS=5
MM_BINANCE_STALE_MS=5000
# MM_FAIR_ANCHOR_LIVE=depth
MM_WARMUP_SAMPLES=32
# Delta top of book: rest (poll /v2/l2orderbook every 250 ms, default) or ws (public ob_l1 websocket, ~100 ms)
# MM_DELTA_BOOK_FEED=ws
# Book older than this (no feed update) cancels quotes once and pauses quoting until it is fresh again
# MM_BOOK_STALE_MS=2000
# A book that keeps arriving but stops changing (top prices and sizes) counts as stale too: after
# MM_FROZEN_BOOK_SEC unchanged while Binance moved at least MM_FROZEN_BOOK_MOVE_BPS since it last changed, or after
# MM_FROZEN_BOOK_MAX_SEC unchanged whatever Binance did, quotes are cancelled until the book changes again
# (17 Oct 2026: Delta froze for 44 min with frames still arriving). 0 switches a rule off.
# MM_FROZEN_BOOK_SEC=30
# MM_FROZEN_BOOK_MOVE_BPS=5
# MM_FROZEN_BOOK_MAX_SEC=120
# Delta ticker (funding rate, mark, spot index) is polled in the background every N ms (2 s request timeout);
# a snapshot older than MM_TICKER_STALE_SEC counts as missing (funding carry 0)
# MM_TICKER_POLL_MS=3000
# MM_TICKER_STALE_SEC=30
# A run with keys (demo or mainnet) waits up to this long for Delta to confirm the private fills feed and exits
# if it does not (or after 2 explicit refusals), since fills would otherwise reach the bot only through the venue
# reconcile. Once quoting, a feed down for longer than MM_FILL_FEED_DOWN_PULL_SEC switches the side that adds to
# the position off until it is back. MM_FILL_FEED_REQUIRED=0 waives both.
# MM_FILL_FEED_WAIT_SEC=20
# MM_FILL_FEED_DOWN_PULL_SEC=30
# MM_FILL_FEED_REQUIRED=1
# Longest wait for any one Delta REST answer (ms, at least 500; connect 1 s). Mainnet order writes take about
# 550 ms. A place that gets no answer may still rest, so the side is tracked without an id and the next loop
# cancels all before quoting again. Every call's time is logged at debug level under the MM_REST target.
# MM_REST_TIMEOUT_MS=3000
# Delta depth mid (public ob_l2, 15 levels every 500 ms, one extra public socket per run): the price where
# cumulative size reaches MM_BASIS_DEPTH_QTY base units (the units of MM_ORDER_QTY; divided by the contract
# value) per side, logged as depth_* in MM_METRICS. Candidate live basis source for the anchored fair; a fixed
# size, so our quotes cannot shift it. Set it per symbol (MM_BASIS_DEPTH_QTY_ADAUSDT) in a gap of the inside
# sizes, well above twice the order size; the default is ADA's. A snapshot older than MM_DEPTH_STALE_MS
# (100 ms-1 h) is not used. MM_DEPTH_FEED=0 drops the socket and the depth fields.
# MM_BASIS_DEPTH_QTY=10000
# MM_DEPTH_STALE_MS=2000
# MM_DEPTH_FEED=1
# DISM: quote fair +/- N bps (x regime multiplier) instead of the AS spread; 0 = off. Profile: config/dism.env
# MM_FIXED_HALF_SPREAD_BPS=5
MM_MARKOUT_THRESHOLD_BPS=3
MM_MARKOUT_WIDEN_BPS=4
MM_MARKOUT_SIDE_AWARE=1

# Regime L3 (cancel-all): lower depth threshold on demo/testnet if book is often one-sided
# Demo: MM_REGIME_L3_DEPTH_RATIO=0 disables depth L3; mainnet ~0.15–0.2
# MM_REGIME_L3_JUMP_BPS=50
# MM_REGIME_L3_FLOW_Z=4
# MM_QUEUE_MAX_FRONT_FRAC=0.9

RUST_LOG=info,mm_bot=info,MM_METRICS=info,MM_ORDER=info
