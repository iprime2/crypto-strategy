# Copy to .env (gitignored). Or: source ~/scripts/source-secrets.sh
#
# SDK credential names (preferred):
GODARK_API_KEY_ID=
GODARK_API_SECRET=
GODARK_PASSPHRASE=
GODARK_EDGE_URL=wss://api.godark-dex.com
GODARK_SYMBOL=BTC-USDC-PERP

# Strategy tuning (conservative defaults — widen before tightening)
MM_HALF_SPREAD_BPS=50
MM_INVENTORY_SKEW_BPS=5
MM_MAX_INVENTORY=0.05
MM_ORDER_QTY=0.01
MM_LOOP_INTERVAL_SEC=5
MM_STALE_FAIR_SEC=30
MM_JUMP_BPS=25
MM_TICK_SIZE=0.01
MM_MAKER_FEE_BPS=2

# Optional: override mark/fair for dry runs
# MM_DRY_RUN=1
# MM_FAIR_OVERRIDE=68000

# Devnet: set GODARK_ENV=devnet and fill GODARK_DEVNET_* in ~/.cursor/secrets.env
# (or export after: source ~/scripts/source-secrets.sh)
