# Devnet runtime overlay (applied after artifacts/devnet/mm-tuning.env).
# Not written by mm-eval — guardrails for thin book + SOL de-risk.
# Restart devnet daemon after edits: bash ~/scripts/mms/stop-mm-devnet-daemon.sh && bash ~/scripts/mms/start-mm-devnet-daemon.sh

MM_CALM_SPREAD_DISCOUNT=0
MM_LOOP_INTERVAL_SEC=10

# Inventory: flatten sooner, especially SOL
MM_INV_ONE_SIDED_RATIO=0.25
MM_INV_ONE_SIDED_RATIO_SOL=0.12
MM_INVENTORY_SKEW_BPS=40
MM_INVENTORY_SKEW_BPS_SOL=55
MM_INV_SPREAD_WIDEN=0.65
MM_BOUNDARY_SKEW_BPS=18

# Adverse selection / markout guard (devnet SOL markouts often >20 bps)
MM_ADVERSE_BUFFER_BPS=10
MM_MARKOUT_WIDEN_BPS=5
MM_MARKOUT_THRESHOLD_BPS=2
MM_MARKOUT_DYNAMIC_MIN=1

# SOL: smaller clips and cap (was ~1.1 SOL stuck long)
MM_ORDER_QTY_SOL=0.15
MM_MAX_INVENTORY_SOL=1.5

# Slightly gentler REST on shared devnet API (6 bots)
MM_REST_PAUSE_MS=350
MM_RATE_LIMIT_BACKOFF_MS=45000
