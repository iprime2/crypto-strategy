# User unit, installed by bitra-desk/setup.sh. Started by bitra-telegram-digest.timer. Sends the desks' digest to
# the owner's Telegram chat. Reads the desks' records and ~/bitra/telegram/telegram.env (the bot's token and
# chat); outbound only, places nothing.
[Unit]
Description=bitra-desk Telegram digest (read-only, outbound only)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/bitra/telegram/telegram.env
Environment=TELEGRAM_ENV_FILE=%h/bitra/telegram/telegram.env
ExecStart=/usr/bin/python3 %h/bitra/telegram/notify.py digest --desk gemini=%h/bitra/desk --desk groq=%h/bitra/desk-groq --desk claude=%h/bitra/desk-claude
TimeoutStartSec=120
