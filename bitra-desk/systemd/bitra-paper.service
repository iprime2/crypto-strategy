# User unit, installed by bitra-desk/setup.sh. Started by bitra-paper.timer. Replays the desk's would-be
# trades as one account on Bybit's public 5-minute bars and writes ~/bitra/paper/state.json; sends nothing.
[Unit]
Description=bitra-desk paper account (no orders)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/bitra/paper/paper.py --desk %h/bitra/desk --out %h/bitra/paper
TimeoutStartSec=300
